<?xml version="1.0" encoding="utf-8"?><!--
   El PIN, los ajustes y las cuentas del dispositivo no se copian a la nube
   ni se transfieren a otro teléfono: son datos locales de este equipo.
   Ver https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="cerrajeria_preferencias.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="cerrajeria_preferencias.xml" />
    </device-transfer>
</data-extraction-rules>
<?xml version='1.0' encoding='utf-8'?>
<resources>
    <!-- Una sola familia (DM Sans). La jerarquía se logra con peso y color, no con otras fuentes. -->
    <style name="TextAppearance.Cerrajeria24Horas.Hero" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/dm_sans_bold</item>
        <item name="fontFamily">@font/dm_sans_bold</item>
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/azul_marino</item>
    </style>
    <style name="TextAppearance.Cerrajeria24Horas.TituloGrande" parent="TextAppearance.Cerrajeria24Horas.Hero">
        <item name="android:textSize">34sp</item>
    </style>
    <style name="TextAppearance.Cerrajeria24Horas.Titulo" parent="TextAppearance.Cerrajeria24Horas.Hero">
        <item name="android:textSize">28sp</item>
    </style>
    <style name="TextAppearance.Cerrajeria24Horas.TituloPantalla" parent="TextAppearance.Cerrajeria24Horas.Titulo"/>
    <style name="TextAppearance.Cerrajeria24Horas.Subtitulo" parent="TextAppearance.Cerrajeria24Horas.Hero">
        <item name="android:fontFamily">@font/dm_sans_semibold</item>
        <item name="fontFamily">@font/dm_sans_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="TextAppearance.Cerrajeria24Horas.Cuerpo" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/dm_sans_regular</item>
        <item name="fontFamily">@font/dm_sans_regular</item>
        <item name="android:textColor">@color/texto_cuerpo</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Cerrajeria24Horas.Etiqueta" parent="TextAppearance.Cerrajeria24Horas.Cuerpo">
        <item name="android:fontFamily">@font/dm_sans_medium</item>
        <item name="fontFamily">@font/dm_sans_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>
    <!-- Cifras: DM Sans Bold con cifras tabulares (tnum) para que no "bailen" al animarse. -->
    <style name="TextAppearance.Cerrajeria24Horas.Cifra" parent="TextAppearance.Cerrajeria24Horas.Cuerpo">
        <item name="android:fontFamily">@font/dm_sans_bold</item>
        <item name="fontFamily">@font/dm_sans_bold</item>
        <item name="android:textSize">36sp</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="TextAppearance.Cerrajeria24Horas.CifraUnidad" parent="TextAppearance.Cerrajeria24Horas.Cuerpo">
        <item name="android:fontFamily">@font/dm_sans_medium</item>
        <item name="fontFamily">@font/dm_sans_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>
    <style name="Cerrajeria24Horas.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:textColorHint">@color/tint_etiqueta_campo</item>
        <item name="boxBackgroundColor">@color/fondo_tarjeta</item>
        <item name="boxStrokeColor">@color/tint_borde_campo</item>
        <item name="boxStrokeErrorColor">@color/rojo_error</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radio_campo</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radio_campo</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radio_campo</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radio_campo</item>
        <item name="hintTextColor">@color/azul_acento</item>
        <item name="hintTextAppearance">@style/TextAppearance.Cerrajeria24Horas.Etiqueta</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.Cerrajeria24Horas.Etiqueta</item>
        <item name="errorTextColor">@color/rojo_error</item>
        <item name="endIconTint">@color/azul_acento</item>
        <item name="startIconTint">@color/texto_secundario</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Cerrajeria24Horas.Campo</item>
    </style>
    <style name="Cerrajeria24Horas.Entrada" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:fontFamily">@font/dm_sans_regular</item>
        <item name="fontFamily">@font/dm_sans_regular</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textColorHint">@color/texto_secundario</item>
        <item name="android:textColorHighlight">@color/seleccion_texto</item>
        <item name="android:textCursorDrawable">@drawable/cursor_campo</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:gravity">start|center_vertical</item>
    </style>
    <style name="Cerrajeria24Horas.TextoSelector" parent="Widget.AppCompat.TextView.SpinnerItem">
        <item name="android:fontFamily">@font/dm_sans_regular</item>
        <item name="fontFamily">@font/dm_sans_regular</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="Cerrajeria24Horas.Boton" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/dm_sans_semibold</item>
        <item name="fontFamily">@font/dm_sans_semibold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.015</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">@dimen/alto_minimo_boton</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radio_pildora</item>
        <item name="iconPadding">12dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconGravity">textStart</item>
        <item name="rippleColor">@color/onda_clara</item>
    </style>
    <style name="Cerrajeria24Horas.BotonPrimario" parent="Cerrajeria24Horas.Boton">
        <item name="backgroundTint">@color/tint_boton_primario</item>
        <item name="android:textColor">@color/tint_texto_claro</item>
        <item name="iconTint">@color/tint_texto_claro</item>
    </style>
    <style name="Cerrajeria24Horas.BotonSecundario" parent="Cerrajeria24Horas.BotonPrimario">
        <item name="backgroundTint">@color/tint_boton_secundario</item>
    </style>
    <style name="Cerrajeria24Horas.BotonDorado" parent="Cerrajeria24Horas.Boton">
        <item name="backgroundTint">@color/tint_boton_dorado</item>
        <item name="android:textColor">@color/tint_texto_oscuro</item>
        <item name="iconTint">@color/tint_texto_oscuro</item>
        <item name="rippleColor">@color/onda_oscura</item>
    </style>
    <!-- Botón de urgencia: el rojo solo se usa para emergencias. -->
    <style name="Cerrajeria24Horas.BotonUrgencia" parent="Cerrajeria24Horas.Boton">
        <item name="backgroundTint">@color/tint_boton_urgencia</item>
        <item name="android:textColor">@color/tint_texto_claro</item>
        <item name="iconTint">@color/tint_texto_claro</item>
    </style>
    <style name="Cerrajeria24Horas.BotonContorno" parent="Cerrajeria24Horas.BotonDorado">
        <item name="backgroundTint">@color/tint_fondo_contorno</item>
        <item name="strokeColor">@color/tint_borde_contorno</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Cerrajeria24Horas.BotonSalir" parent="Cerrajeria24Horas.BotonContorno">
        <item name="android:textColor">@color/rojo_error</item>
        <item name="iconTint">@color/rojo_error</item>
        <item name="strokeColor">@color/rojo_error</item>
        <item name="backgroundTint">@color/rojo_suave</item>
    </style>
    <!-- Control segmentado: opciones en píldora; la marcada se rellena con azul cobalto. -->
    <style name="Cerrajeria24Horas.BotonSegmento" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/dm_sans_semibold</item>
        <item name="fontFamily">@font/dm_sans_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/segmento_texto</item>
        <item name="backgroundTint">@color/segmento_fondo</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">@dimen/radio_pildora</item>
        <item name="rippleColor">@color/onda_oscura</item>
    </style>
    <style name="Cerrajeria24Horas.Transiciones" parent="android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>

    <!-- Botón de icono circular (reemplaza los cuadrados de 16dp). -->
    <style name="Cerrajeria24Horas.BotonIcono" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">@dimen/zona_tactil</item>
        <item name="android:layout_height">@dimen/zona_tactil</item>
        <item name="backgroundTint">@color/fondo_suave</item>
        <item name="iconTint">@color/azul_marino</item>
        <item name="iconSize">24dp</item>
        <item name="cornerRadius">@dimen/radio_pildora</item>
        <item name="rippleColor">@color/onda_oscura</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Cerrajeria24Horas.BotonIconoClaro" parent="Cerrajeria24Horas.BotonIcono">
        <item name="backgroundTint">@color/white</item>
        <item name="iconTint">@color/azul_marino</item>
    </style>

    <!-- Chips en píldora sobre el sistema de Material 3. -->
    <style name="Cerrajeria24Horas.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:fontFamily">@font/dm_sans_semibold</item>
        <item name="fontFamily">@font/dm_sans_semibold</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipBackgroundColor">@color/fondo_tarjeta</item>
        <item name="chipStrokeColor">@color/borde</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/texto_cuerpo</item>
        <item name="chipIconTint">@color/azul_acento</item>
    </style>

    <!-- Tarjetas: se distinguen por color de superficie, sin borde de 1dp. -->
    <style name="Widget.Cerrajeria24Horas.Tarjeta" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/fondo_tarjeta</item>
        <item name="cardCornerRadius">@dimen/radio_tarjeta</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.Cerrajeria24Horas.TarjetaHeroe" parent="Widget.Cerrajeria24Horas.Tarjeta">
        <item name="cardCornerRadius">@dimen/radio_heroe</item>
    </style>
    <style name="Widget.Cerrajeria24Horas.TarjetaInicio" parent="Widget.Cerrajeria24Horas.Tarjeta">
        <item name="cardBackgroundColor">@color/superficie_inicio</item>
    </style>
    <style name="Widget.Cerrajeria24Horas.TarjetaServicios" parent="Widget.Cerrajeria24Horas.Tarjeta">
        <item name="cardBackgroundColor">@color/superficie_servicios</item>
    </style>
    <style name="Widget.Cerrajeria24Horas.TarjetaClientes" parent="Widget.Cerrajeria24Horas.Tarjeta">
        <item name="cardBackgroundColor">@color/superficie_clientes</item>
    </style>
</resources>

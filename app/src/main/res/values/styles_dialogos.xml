<resources>
    <style name="ShapeAppearance.Cerrajeria24Horas.Ventana" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radio_ventana</item>
    </style>
    <style name="ShapeAppearance.Cerrajeria24Horas.Campo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radio_campo</item>
    </style>
    <style name="Theme.Cerrajeria24Horas.Dialogo" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:fontFamily">@font/tipografia_dm_sans</item>
        <item name="fontFamily">@font/tipografia_dm_sans</item>
        <item name="colorPrimary">@color/azul_marino</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/fondo_tarjeta</item>
        <item name="colorOnSurface">@color/texto_principal</item>
        <item name="android:windowAnimationStyle">@style/Cerrajeria24Horas.AnimacionDialogo</item>
    </style>
    <style name="Cerrajeria24Horas.AnimacionDialogo" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>
    <style name="Cerrajeria24Horas.BotonDialogo" parent="Cerrajeria24Horas.Boton">
        <item name="android:maxLines">1</item>
        <item name="android:scrollHorizontally">false</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="autoSizeMaxTextSize">16sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>
    <style name="Cerrajeria24Horas.BotonDialogoConfirmar" parent="Cerrajeria24Horas.BotonDialogo">
        <item name="backgroundTint">@color/tint_boton_primario</item>
        <item name="android:textColor">@color/tint_texto_claro</item>
    </style>
    <style name="Cerrajeria24Horas.BotonDialogoCancelar" parent="Cerrajeria24Horas.BotonDialogo">
        <item name="backgroundTint">@color/tint_fondo_contorno</item>
        <item name="android:textColor">@color/tint_texto_oscuro</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/tint_borde_contorno</item>
        <item name="rippleColor">@color/onda_oscura</item>
    </style>
    <style name="ThemeOverlay.Cerrajeria24Horas.Selector" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:fontFamily">@font/tipografia_dm_sans</item>
        <item name="fontFamily">@font/tipografia_dm_sans</item>
        <item name="android:textColorPrimary">@color/texto_principal</item>
        <item name="colorControlActivated">@color/azul_acento</item>
        <item name="colorControlHighlight">@color/onda_oscura</item>
        <item name="dropDownListViewStyle">@style/Widget.Cerrajeria24Horas.ListaOpciones</item>
        <item name="android:dropDownListViewStyle">@style/Widget.Cerrajeria24Horas.ListaOpciones</item>
    </style>
    <style name="Widget.Cerrajeria24Horas.ListaOpciones" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:listSelector">@android:color/transparent</item>
        <item name="android:divider">@android:color/transparent</item>
        <item name="android:dividerHeight">4dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
    <style name="ThemeOverlay.Cerrajeria24Horas.Calendario" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/azul_marino</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/azul_acento_claro</item>
        <item name="colorOnPrimaryContainer">@color/azul_marino</item>
        <item name="colorSurface">@color/fondo_tarjeta</item>
        <item name="colorOnSurface">@color/texto_principal</item>
        <item name="android:fontFamily">@font/tipografia_dm_sans</item>
        <item name="fontFamily">@font/tipografia_dm_sans</item>
        <item name="materialCalendarStyle">@style/Widget.Cerrajeria24Horas.Calendario</item>
        <item name="materialCalendarHeaderTitle">@style/Widget.Cerrajeria24Horas.CalendarioTitulo</item>
        <item name="materialCalendarHeaderSelection">@style/Widget.Cerrajeria24Horas.CalendarioFecha</item>
        <item name="buttonBarPositiveButtonStyle">@style/Cerrajeria24Horas.BotonSelectorConfirmar</item>
        <item name="buttonBarNegativeButtonStyle">@style/Cerrajeria24Horas.BotonSelectorCancelar</item>
        <item name="materialCalendarHeaderConfirmButton">@style/Cerrajeria24Horas.BotonSelectorConfirmar</item>
        <item name="materialCalendarHeaderCancelButton">@style/Cerrajeria24Horas.BotonSelectorCancelar</item>
        <item name="textInputStyle">@style/Cerrajeria24Horas.Campo</item>
    </style>
    <style name="Widget.Cerrajeria24Horas.Calendario" parent="Widget.Material3.MaterialCalendar">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Cerrajeria24Horas.Ventana</item>
        <item name="backgroundTint">@color/fondo_tarjeta</item>
    </style>
    <style name="Widget.Cerrajeria24Horas.CalendarioTitulo" parent="Widget.Material3.MaterialCalendar.HeaderTitle">
        <item name="android:fontFamily">@font/dm_sans_medium</item>
        <item name="fontFamily">@font/dm_sans_medium</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>
    <style name="Widget.Cerrajeria24Horas.CalendarioFecha" parent="Widget.Material3.MaterialCalendar.HeaderSelection">
        <item name="android:fontFamily">@font/dm_sans_bold</item>
        <item name="fontFamily">@font/dm_sans_bold</item>
        <item name="android:textColor">@color/azul_marino</item>
    </style>
    <style name="ThemeOverlay.Cerrajeria24Horas.Reloj" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="colorPrimary">@color/azul_marino</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/azul_acento_claro</item>
        <item name="colorOnPrimaryContainer">@color/azul_marino</item>
        <item name="colorSurface">@color/fondo_tarjeta</item>
        <item name="colorOnSurface">@color/texto_principal</item>
        <item name="android:fontFamily">@font/tipografia_dm_sans</item>
        <item name="fontFamily">@font/tipografia_dm_sans</item>
        <item name="materialTimePickerStyle">@style/Widget.Cerrajeria24Horas.Reloj</item>
        <item name="materialClockStyle">@style/Widget.Cerrajeria24Horas.EsferaReloj</item>
        <item name="chipStyle">@style/Widget.Cerrajeria24Horas.DigitosReloj</item>
        <item name="textInputStyle">@style/Widget.Cerrajeria24Horas.EntradaHora</item>
        <item name="materialTimePickerTitleStyle">@style/TextAppearance.Cerrajeria24Horas.TituloSelector</item>
        <item name="buttonBarPositiveButtonStyle">@style/Cerrajeria24Horas.BotonSelectorConfirmar</item>
        <item name="buttonBarNegativeButtonStyle">@style/Cerrajeria24Horas.BotonSelectorCancelar</item>
    </style>
    <style name="Widget.Cerrajeria24Horas.Reloj" parent="Widget.Material3.MaterialTimePicker">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Cerrajeria24Horas.Ventana</item>
        <item name="backgroundTint">@color/fondo_tarjeta</item>
    </style>
    <style name="Widget.Cerrajeria24Horas.EsferaReloj" parent="Widget.Material3.MaterialTimePicker.Clock">
        <item name="clockFaceBackgroundColor">@color/azul_acento_claro</item>
        <item name="clockHandColor">@color/azul_acento</item>
    </style>
    <style name="Widget.Cerrajeria24Horas.DigitosReloj" parent="Widget.Material3.MaterialTimePicker.Display">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Cerrajeria24Horas.Campo</item>
    </style>
    <style name="Widget.Cerrajeria24Horas.EntradaHora" parent="Widget.Material3.MaterialTimePicker.Display.TextInputLayout">
        <item name="boxCornerRadiusTopStart">@dimen/radio_campo</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radio_campo</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radio_campo</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radio_campo</item>
    </style>
    <style name="TextAppearance.Cerrajeria24Horas.TituloSelector" parent="TextAppearance.Material3.MaterialTimePicker.Title">
        <item name="android:fontFamily">@font/dm_sans_bold</item>
        <item name="fontFamily">@font/dm_sans_bold</item>
        <item name="android:textColor">@color/azul_marino</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="Cerrajeria24Horas.BotonSelectorCancelar" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/dm_sans_semibold</item>
        <item name="fontFamily">@font/dm_sans_semibold</item>
        <item name="android:textColor">@color/azul_marino</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:scrollHorizontally">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="rippleColor">@color/onda_oscura</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">12sp</item>
        <item name="autoSizeMaxTextSize">14sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>
    <style name="Cerrajeria24Horas.BotonSelectorConfirmar" parent="Cerrajeria24Horas.BotonSelectorCancelar">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/tint_boton_primario</item>
        <item name="rippleColor">@color/onda_clara</item>
    </style>
</resources>

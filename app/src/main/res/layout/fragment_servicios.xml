<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="@dimen/espacio_barra_navegacion">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingTop="@dimen/espacio_12"
        android:paddingBottom="@dimen/espacio_8"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsServicios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedChip="@id/chipTodos">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                style="@style/Cerrajeria24Horas.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/todos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPendientes"
                style="@style/Cerrajeria24Horas.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pendientes" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEnProceso"
                style="@style/Cerrajeria24Horas.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/en_proceso" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRealizados"
                style="@style/Cerrajeria24Horas.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/realizados" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvServicios"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingTop="@dimen/margen_pantalla"
            android:paddingBottom="@dimen/espacio_16"
            android:clipToPadding="false" />

        <LinearLayout
            android:id="@+id/emptyServicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_llave_doble"
                app:tint="@color/azul_acento"
                android:background="@drawable/bg_acento_suave"
                android:padding="16dp"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/sin_servicios"
                android:textColor="@color/texto_secundario"
                android:textAppearance="@style/TextAppearance.Cerrajeria24Horas.Cuerpo"
                android:gravity="center" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbServicios"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/azul_acento" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegistrarServicio"
        style="@style/Cerrajeria24Horas.BotonSecundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:layout_marginBottom="@dimen/espacio_12"
        android:text="@string/subir_servicio"
        android:textSize="16sp"
        app:icon="@drawable/ic_mas" />
</LinearLayout>

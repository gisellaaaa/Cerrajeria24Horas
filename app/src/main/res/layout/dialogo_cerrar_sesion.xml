<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dlgContenido"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialogo"
    android:gravity="center_horizontal">
    <TextView
        android:id="@+id/dlgTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="@font/dm_sans_regular"
        android:text="@string/cerrar_sesion_confirmar"
        android:textColor="@color/texto_principal"
        android:textSize="17sp"
        android:breakStrategy="simple" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDlgCancelar"
        style="@style/Cerrajeria24Horas.BotonDialogoCancelar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/cancelar" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDlgConfirmar"
        style="@style/Cerrajeria24Horas.BotonSalir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/cerrar_sesion"
        app:strokeWidth="1dp"
        app:icon="@drawable/ic_logout"
        app:iconGravity="textStart" />
</LinearLayout>
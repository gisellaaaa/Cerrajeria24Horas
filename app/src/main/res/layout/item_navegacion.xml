<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:clickable="true"
    android:focusable="true"
    android:minWidth="@dimen/zona_tactil"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="?attr/selectableItemBackgroundBorderless">

    <FrameLayout
        android:id="@+id/navPildora"
        android:layout_width="40dp"
        android:layout_height="28dp">

        <ImageView
            android:id="@+id/navIcono"
            android:layout_width="@dimen/icono_barra_navegacion"
            android:layout_height="@dimen/icono_barra_navegacion"
            android:layout_gravity="center"
            android:src="@drawable/ic_inicio"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/navTexto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.Cerrajeria24Horas.Etiqueta"
        android:textColor="@color/nav_texto_inactivo" />
</LinearLayout>

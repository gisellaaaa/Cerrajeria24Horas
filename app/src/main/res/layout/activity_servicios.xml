<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_fondo_app">
    <include android:id="@+id/enc" layout="@layout/encabezado_actividad"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvServicios" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="@dimen/margen_pantalla" android:paddingBottom="8dp" android:clipToPadding="false"/>
        <LinearLayout android:id="@+id/emptyServicios" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center" android:padding="32dp" android:visibility="gone">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_key" app:tint="@color/azul_acento" android:background="@drawable/bg_acento_suave" android:padding="16dp" android:importantForAccessibility="no"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/sin_servicios" android:textColor="@color/texto_secundario" android:textSize="16sp" android:gravity="center" android:fontFamily="@font/dm_sans_regular"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/pbServicios" style="?android:attr/progressBarStyleLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" android:indeterminateTint="@color/azul_acento"/>
    </FrameLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnRegistrarServicio" style="@style/Cerrajeria24Horas.BotonSecundario" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="@dimen/margen_pantalla" android:text="@string/subir_servicio" android:textSize="16sp" app:icon="@drawable/ic_key"/>
</LinearLayout>

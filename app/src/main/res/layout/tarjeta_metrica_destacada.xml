<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/fondo_tarjeta"
    app:cardCornerRadius="@dimen/radio_tarjeta"
    app:strokeWidth="1dp"
    app:strokeColor="@color/borde"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="140dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <FrameLayout
            android:id="@+id/fondoMetricaIcono"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circulo_acento">

            <ImageView
                android:id="@+id/ivMetricaIcono"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_reloj"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/espacio_16"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMetricaValor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans_bold"
                android:textColor="@color/azul_marino"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/tvMetricaTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/dm_sans_medium"
                android:textColor="@color/texto_secundario"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

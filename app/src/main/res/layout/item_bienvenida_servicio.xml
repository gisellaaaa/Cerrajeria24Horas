<?xml version="1.0" encoding="utf-8"?>
<!-- Página del carrusel: imagen cuadrada del servicio, título y descripción.
     Sin ScrollView: así ViewPager2 mide correctamente todas las páginas y puede deslizarlas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="@dimen/margen_formulario"
    android:paddingEnd="@dimen/margen_formulario"
    android:paddingTop="@dimen/espacio_8"
    android:paddingBottom="@dimen/espacio_8">

    <LinearLayout
        android:id="@+id/carContenido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:id="@+id/carCuadro"
            android:layout_width="152dp"
            android:layout_height="152dp"
            android:background="@drawable/bg_cuadro_servicio"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/carIcono"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:tint="@color/azul_marino" />
        </FrameLayout>

        <TextView
            android:id="@+id/carTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_16"
            android:gravity="center"
            android:textColor="@color/azul_marino"
            android:textSize="22sp"
            android:fontFamily="@font/dm_sans_bold" />

        <TextView
            android:id="@+id/carDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_8"
            android:gravity="center"
            android:maxWidth="340dp"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            android:fontFamily="@font/dm_sans_regular"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>
</LinearLayout>

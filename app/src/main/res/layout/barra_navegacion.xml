<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:baselineAligned="false">

            <include
                android:id="@+id/navInicio"
                layout="@layout/item_navegacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/navServicios"
                layout="@layout/item_navegacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <Space
            android:layout_width="@dimen/hueco_barra_navegacion"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:baselineAligned="false">

            <include
                android:id="@+id/navClientes"
                layout="@layout/item_navegacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/navGanancias"
                layout="@layout/item_navegacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/navEquipo"
                layout="@layout/item_navegacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnCentral"
        android:layout_width="@dimen/boton_central_navegacion"
        android:layout_height="@dimen/boton_central_navegacion"
        android:layout_gravity="top|center_horizontal"
        android:padding="16dp"
        android:background="@drawable/bg_boton_central"
        android:src="@drawable/ic_mas"
        android:contentDescription="@string/nuevo_servicio" />
</merge>

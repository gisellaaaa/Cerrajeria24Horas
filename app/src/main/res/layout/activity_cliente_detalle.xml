<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/fondo">
    <include android:id="@+id/enc" layout="@layout/encabezado_actividad"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/margen_pantalla">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_tarjeta" android:padding="18dp">
                    <TextView android:id="@+id/tvCNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/azul_marino" android:textAppearance="@style/TextAppearance.Cerrajeria24Horas.TituloPantalla"/>
                    <TextView android:id="@+id/tvCTelefono" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/texto_principal" android:textSize="15sp" android:fontFamily="@font/dm_sans_regular"/>
                    <TextView android:id="@+id/tvCCorreo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/texto_principal" android:textSize="15sp" android:fontFamily="@font/dm_sans_regular"/>
                    <TextView android:id="@+id/tvCCiudad" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/texto_principal" android:textSize="15sp" android:fontFamily="@font/dm_sans_regular"/>
                    <TextView android:id="@+id/tvCDireccion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/texto_principal" android:textSize="15sp" android:fontFamily="@font/dm_sans_regular"/>
                    <TextView android:id="@+id/tvCNotas" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/texto_secundario" android:textSize="14sp" android:visibility="gone" android:fontFamily="@font/dm_sans_regular"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnRegistrarServicioDeCliente" style="@style/Cerrajeria24Horas.BotonDorado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/registrar_servicio" android:textSize="15sp" app:icon="@drawable/ic_key"/>
                <ImageView android:layout_width="80dp" android:layout_height="80dp" android:layout_gravity="center_horizontal" android:layout_marginTop="28dp" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/logo" android:contentDescription="@string/nombre_empresa"/>
            </LinearLayout>
        </ScrollView>
        <ProgressBar android:id="@+id/pbClienteDetalle" style="?android:attr/progressBarStyleLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" android:indeterminateTint="@color/azul_acento"/>
    </FrameLayout>
</LinearLayout>

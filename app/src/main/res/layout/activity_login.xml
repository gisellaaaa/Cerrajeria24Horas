<?xml version="1.0" encoding="utf-8"?>
<!-- Acceso: cabecera arriba, formulario centrado y pie abajo. El cuerpo se centra cuando
     sobra espacio y se desplaza solo si no cabe, así nunca se cortan los campos. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raizLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fondo_app"
    android:paddingStart="@dimen/margen_formulario"
    android:paddingEnd="@dimen/margen_formulario">

    <LinearLayout
        android:id="@+id/llCabeceraLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="@dimen/espacio_acceso_superior"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/logoLogin"
            android:layout_width="@dimen/logo_acceso"
            android:layout_height="@dimen/logo_acceso"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logo"
            android:contentDescription="@string/nombre_empresa" />

        <TextView
            android:id="@+id/tvMarca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="none"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="26sp"
            android:autoSizeStepGranularity="1sp"
            android:textAppearance="@style/TextAppearance.Cerrajeria24Horas.TituloGrande" />

        <TextView
            android:id="@+id/tvEslogan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/eslogan"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            android:fontFamily="@font/dm_sans_regular" />

        <View
            android:id="@+id/acentoLogin"
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:background="@color/oro" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/svCuerpoLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/espacio_16"
        android:layout_marginBottom="@dimen/espacio_12"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/llCabeceraLogin"
        app:layout_constraintBottom_toTopOf="@id/llPieLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/llCuerpoLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/cardLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_tarjeta">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/acceso_cuenta"
                    android:textAppearance="@style/TextAppearance.Cerrajeria24Horas.Subtitulo" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Cerrajeria24Horas.Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/correo">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLoginCorreo"
                        style="@style/Cerrajeria24Horas.Entrada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textColor="@color/texto_principal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Cerrajeria24Horas.Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/contrasena"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLoginPassword"
                        style="@style/Cerrajeria24Horas.Entrada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/texto_principal" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvOlvideContrasena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:minHeight="@dimen/zona_tactil"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/olvide_contrasena"
                    android:textColor="@color/azul_acento"
                    android:textSize="14sp"
                    android:fontFamily="@font/dm_sans_semibold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    style="@style/Cerrajeria24Horas.BotonPrimario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/iniciar_sesion" />

                <ProgressBar
                    android:id="@+id/pbLogin"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    android:indeterminateTint="@color/azul_acento" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llCuentasDispositivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_12"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cuentas_dispositivo"
                    android:textColor="@color/azul_marino"
                    android:textSize="13sp"
                    android:fontFamily="@font/dm_sans_bold"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:id="@+id/llCuentasLista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/tvSinCuentas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/sin_cuentas_guardadas"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp"
                    android:fontFamily="@font/dm_sans_regular" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/llPieLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="@dimen/espacio_8"
        android:paddingBottom="@dimen/espacio_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="@dimen/espacio_12"
            android:background="@color/borde" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/sin_cuenta"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            android:fontFamily="@font/dm_sans_regular" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrRegistro"
            style="@style/Cerrajeria24Horas.BotonContorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/crear_cuenta" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

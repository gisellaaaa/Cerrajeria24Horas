<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_fondo_app"
    android:clipToPadding="false"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_formulario"
            android:paddingEnd="@dimen/margen_formulario"
            android:paddingTop="@dimen/espacio_acceso_superior"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="@dimen/logo_acceso"
                android:layout_height="@dimen/logo_acceso"
                android:layout_gravity="center_horizontal"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/logo"
                android:contentDescription="@string/nombre_empresa" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/marca_cerrajeria"
                    android:textAppearance="@style/TextAppearance.Cerrajeria24Horas.TituloGrande" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/marca_24_horas"
                    android:textAppearance="@style/TextAppearance.Cerrajeria24Horas.TituloGrande"
                    android:textColor="@color/rojo_urgencia" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/eslogan"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp"
                android:fontFamily="@font/dm_sans_regular" />

            <View
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:background="@color/oro" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_tarjeta">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/acceso_cuenta"
                    android:textAppearance="@style/TextAppearance.Cerrajeria24Horas.Titulo" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Cerrajeria24Horas.Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/correo">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLoginCorreo"
                        style="@style/Cerrajeria24Horas.Entrada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textColor="@color/texto_principal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Cerrajeria24Horas.Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/contrasena"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLoginPassword"
                        style="@style/Cerrajeria24Horas.Entrada"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/texto_principal" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvOlvideContrasena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:minHeight="@dimen/zona_tactil"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/olvide_contrasena"
                    android:textColor="@color/azul_acento"
                    android:textSize="14sp"
                    android:fontFamily="@font/dm_sans_semibold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    style="@style/Cerrajeria24Horas.BotonPrimario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/iniciar_sesion" />

                <ProgressBar
                    android:id="@+id/pbLogin"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:visibility="gone"
                    android:indeterminateTint="@color/azul_acento" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llCuentasDispositivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cuentas_dispositivo"
                    android:textColor="@color/azul_marino"
                    android:textSize="13sp"
                    android:fontFamily="@font/dm_sans_bold"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:id="@+id/llCuentasLista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvSinCuentas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/sin_cuentas_guardadas"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp"
                    android:fontFamily="@font/dm_sans_regular" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/sin_cuenta"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp"
                android:fontFamily="@font/dm_sans_regular" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrRegistro"
                style="@style/Cerrajeria24Horas.BotonContorno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/crear_cuenta" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<!-- Acceso: todo cabe sin desplazamiento. La cabecera se encoge cuando sube el teclado. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raizLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fondo_app"
    android:paddingStart="@dimen/margen_formulario"
    android:paddingEnd="@dimen/margen_formulario">

    <LinearLayout
        android:id="@+id/llCabeceraLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="@dimen/espacio_acceso_superior"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardLogin"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:id="@+id/logoLogin"
            android:layout_width="@dimen/logo_acceso"
            android:layout_height="@dimen/logo_acceso"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logo"
            android:contentDescription="@string/nombre_empresa" />

        <TextView
            android:id="@+id/tvMarca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="none"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeMaxTextSize="34sp"
            android:autoSizeStepGranularity="1sp"
            android:textAppearance="@style/TextAppearance.Cerrajeria24Horas.TituloGrande" />

        <TextView
            android:id="@+id/tvEslogan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/eslogan"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            android:fontFamily="@font/dm_sans_regular" />

        <View
            android:id="@+id/acentoLogin"
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:background="@color/oro" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_16"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/bg_tarjeta"
        app:layout_constraintTop_toBottomOf="@id/llCabeceraLogin"
        app:layout_constraintBottom_toTopOf="@id/llCuentasDispositivo">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/acceso_cuenta"
            android:textAppearance="@style/TextAppearance.Cerrajeria24Horas.Titulo" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Cerrajeria24Horas.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/correo">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLoginCorreo"
                style="@style/Cerrajeria24Horas.Entrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:textColor="@color/texto_principal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Cerrajeria24Horas.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/contrasena"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLoginPassword"
                style="@style/Cerrajeria24Horas.Entrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/texto_principal" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvOlvideContrasena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:minHeight="@dimen/zona_tactil"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/olvide_contrasena"
            android:textColor="@color/azul_acento"
            android:textSize="14sp"
            android:fontFamily="@font/dm_sans_semibold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Cerrajeria24Horas.BotonPrimario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/iniciar_sesion" />

        <ProgressBar
            android:id="@+id/pbLogin"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            android:indeterminateTint="@color/azul_acento" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llCuentasDispositivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_16"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cardLogin"
        app:layout_constraintBottom_toTopOf="@id/llPieLogin">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cuentas_dispositivo"
            android:textColor="@color/azul_marino"
            android:textSize="13sp"
            android:fontFamily="@font/dm_sans_bold"
            android:textAllCaps="true" />

        <LinearLayout
            android:id="@+id/llCuentasLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tvSinCuentas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sin_cuentas_guardadas"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp"
            android:fontFamily="@font/dm_sans_regular" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llPieLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_12"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="@dimen/espacio_8"
        android:paddingBottom="@dimen/espacio_16"
        app:layout_constraintTop_toBottomOf="@id/llCuentasDispositivo"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/sin_cuenta"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            android:fontFamily="@font/dm_sans_regular" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrRegistro"
            style="@style/Cerrajeria24Horas.BotonContorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/crear_cuenta" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/espacio_20"
        android:paddingEnd="@dimen/espacio_12"
        android:paddingTop="@dimen/espacio_12"
        android:paddingBottom="@dimen/espacio_12">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logo"
            android:contentDescription="@string/nombre_empresa" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/espacio_12"
            android:layout_marginEnd="@dimen/espacio_8"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/marca_cerrajeria"
                    android:textAppearance="@style/TextAppearance.Cerrajeria24Horas.Titulo"
                    android:textColor="@color/azul_marino" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/marca_24_horas"
                    android:textAppearance="@style/TextAppearance.Cerrajeria24Horas.Titulo"
                    android:textColor="@color/rojo_urgencia" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/panel_gestion"
                android:textColor="@color/texto_secundario"
                android:textAppearance="@style/TextAppearance.Cerrajeria24Horas.Etiqueta" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnIrPerfil"
            android:layout_width="@dimen/zona_tactil"
            android:layout_height="@dimen/zona_tactil"
            android:padding="12dp"
            android:background="@drawable/bg_boton_icono"
            android:src="@drawable/ic_person"
            app:tint="@color/azul_marino"
            android:contentDescription="@string/mi_perfil" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/contenedorFragmentos"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.cerrajeria24horas.util.BarraNavegacionFlotante
            android:id="@+id/barraNavegacion"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_total_barra_navegacion"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/margen_barra_navegacion"
            android:layout_marginEnd="@dimen/margen_barra_navegacion"
            android:layout_marginBottom="@dimen/espacio_12" />
    </FrameLayout>
</LinearLayout>
